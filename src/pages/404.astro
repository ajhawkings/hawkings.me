---
import BaseLayout from '~/layouts/BaseLayout.astro'

Astro.response.status = 404
---

<BaseLayout title="404 — Angus Hawkings" description="Page not found" noIndex>
  <main class="wrap">
    <div class="card glass">
      <h1>404</h1>
      <p>Nothing here.</p>
      <a class="home" href="/">← back home</a>
    </div>
  </main>
</BaseLayout>

<style>
  .wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 90px 24px 80px;
  }
  .card {
    text-align: center;
    padding: 38px 44px;
  }
  h1 {
    font-size: clamp(56px, 12vw, 96px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  p {
    margin: 10px 0 20px;
    font-size: 15px;
    color: var(--muted);
  }
  .home {
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
  }
  .home:hover {
    text-decoration: underline;
  }
</style>
