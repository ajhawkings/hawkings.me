---
import { getCollection } from 'astro:content'
import PhysicsDock from '~/components/PhysicsDock.astro'
import ProjectCard from '~/components/ProjectCard.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'

export const prerender = true

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
)
---

<BaseLayout
  title="Angus Hawkings"
  description="Product, engineering and infrastructure work from Angus Hawkings."
>
  <main class="wrap">
    <header class="hero">
      <h1>
        Hi, I'm Angus. <br />Product Manager. <br />Passionate about technology.
      </h1>
      <div class="chips" aria-label="Current focus">
        <div class="chip glass">
          <span class="chip-label">Product Manager Intern at</span>
          <span class="chip-value orange">Cloudflare</span>
        </div>
        <div class="chip glass">
          <span class="chip-label">Computer Science at</span>
          <span class="chip-value uoe">The University of Edinburgh</span>
        </div>
        <div class="chip glass">
          <span class="chip-label">Incoming Exchange Student at</span>
          <span class="chip-value eth">ETH Zürich</span>
        </div>
      </div>
      <p class="hero-sub">
        I'm a <strong>Computer Science student</strong> going into my third year.
        I have a passion for web infrastructure, technology and design. Currently
        at <span class="orange">Cloudflare</span> as a Product Manager Intern, working
        on versions & deployments for Workers
      </p>

      <PhysicsDock />
    </header>

    <section class="section" id="work">
      <div class="section-head">
        <h2>Selected work</h2>
        <a href="/projects">All projects -&gt;</a>
      </div>
      <div class="cards">
        {
          projects.map((project) => (
            <ProjectCard
              href={`/projects/${project.id}/`}
              tag={project.data.tag}
              title={project.data.title}
              description={project.data.description}
              label={project.data.linkLabel}
            />
          ))
        }
      </div>
    </section>

    <section class="section" id="writing">
      <div class="section-head">
        <h2>Writing</h2>
        <a href="/blog">All posts -&gt;</a>
      </div>
      {
        posts.length > 0 ? (
          posts.map((post) => (
            <a
              class={`post-row glass ${post.data.draft ? 'soon' : ''}`}
              href={`/blog/${post.id}/`}
            >
              <div class="t">{post.data.title}</div>
              <div class="d">
                {post.data.draft
                  ? 'COMING SOON'
                  : post.data.pubDate.getFullYear()}
              </div>
            </a>
          ))
        ) : (
          <div class="post-row glass soon">
            <div class="t">Writing is warming up.</div>
            <div class="d">SOON</div>
          </div>
        )
      }
    </section>

    <footer class="footer">
      BUILT WITH ASTRO · RUNS ON CLOUDFLARE WORKERS
    </footer>
  </main>
</BaseLayout>
