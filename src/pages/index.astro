---
import PhysicsDock from '~/components/PhysicsDock.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'

export const prerender = true
---

<BaseLayout
  title="Angus Hawkings"
  description="Computer Science student at the University of Edinburgh. Product Manager Intern at Cloudflare. Passionate about technology, web infrastructure and design."
>
  <main class="wrap">
    <header class="hero">
      <h1>
        Hi, I'm Angus. <br />Product Manager. <br />Passionate about technology.
      </h1>
      <ul class="chips" aria-label="Current focus">
        <li class="chip glass">
          <span class="chip-label">Product Manager Intern at </span>
          <span class="chip-value orange">Cloudflare</span>
        </li>
        <li class="chip glass">
          <span class="chip-label">Computer Science at </span>
          <span class="chip-value uoe">The University of Edinburgh</span>
        </li>
        <li class="chip glass">
          <span class="chip-label">Incoming Exchange Student at </span>
          <span class="chip-value eth">ETH Zürich</span>
        </li>
      </ul>
      <p class="hero-sub">
        I'm a <strong>Computer Science student</strong> going into my third year.
        I have a passion for web infrastructure, technology and design. Currently
        at <span class="orange">Cloudflare</span> as a Product Manager Intern, working
        on versions & deployments for Workers
      </p>

      <PhysicsDock />
    </header>

    <footer class="footer">
      BUILT WITH ASTRO · RUNS ON CLOUDFLARE WORKERS
    </footer>
  </main>
</BaseLayout>
