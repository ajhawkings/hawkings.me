---
import PhysicsDock from '~/components/PhysicsDock.astro'
import BaseLayout from '~/layouts/BaseLayout.astro'

export const prerender = true
---

<BaseLayout
  title="Angus Hawkings"
  description="Computer Science student at the University of Edinburgh, currently on exchange at ETH Zürich. Previously a Product Manager Intern at Cloudflare, working on skew protection for Workers."
>
  <main class="wrap">
    <header class="hero">
      <h1>Hi, I'm Angus.<br />I build products for the internet.</h1>

      <p class="career-highlight">
        Most recently, I was a <strong class="orange"
          >Product Manager Intern at Cloudflare</strong
        >, where I worked on <strong
          >skew protection for Cloudflare Workers</strong
        >
        <span class="coming-soon">– coming soon.</span>
      </p>

      <p class="hero-sub">
        I'm now spending the third year of my Computer Science degree at the
        University of Edinburgh on exchange at <strong class="eth"
          >ETH Zürich</strong
        >. I'm interested in web infrastructure, AI, technology and design.
      </p>

      <PhysicsDock />
    </header>
  </main>
</BaseLayout>
