---
import BaseLayout from '~/layouts/BaseLayout.astro'

// SSR so the site key resolves from the runtime Worker var (process.env via
// nodejs_compat) — prerendering would bake in the build-time fallback.
const SITE_KEY = process.env.TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA'
---

<BaseLayout
  title="Say hello — Angus Hawkings"
  description="Details on how to get in touch with me"
>
  <script
    slot="head"
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer></script>

  <main class="wrap">
    <section class="contact-panel glass">
      <h1>Say hello</h1>
      <p class="lead">
        Complete the quick check and I’ll show you the right email address.
      </p>

      <form class="contact-form" id="contact-form">
        <div
          class="cf-turnstile"
          data-sitekey={SITE_KEY}
          data-callback="onTurnstileSuccess"
        >
        </div>
        <noscript>
          <p class="status error">
            JavaScript is required to complete this check.
          </p>
        </noscript>
      </form>

      <p class="status" id="contact-status" aria-live="polite"></p>

      <div class="email-result" id="email-result" hidden>
        <a class="email-link" id="email-link"></a>
        <button class="button" id="copy-btn" type="button">Copy address</button>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  window.onTurnstileSuccess = async function (token) {
    const status = document.getElementById('contact-status')
    const form = document.getElementById('contact-form')
    const result = document.getElementById('email-result')
    const emailLink = document.getElementById('email-link')
    const copyBtn = document.getElementById('copy-btn')

    if (!status || !form || !result || !emailLink || !copyBtn) return

    status.textContent = 'Checking...'
    status.classList.remove('error')

    const body = new FormData()
    body.append('cf-turnstile-response', token)

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        body,
      })
      // Guard the parse: an upstream error page (e.g. a Cloudflare 5xx) is
      // HTML, and a raw SyntaxError message must never reach the visitor.
      const data = await response.json().catch(() => null)

      if (!response.ok || !data?.email) {
        throw new Error(data?.error || 'Verification failed. Please try again.')
      }

      emailLink.textContent = data.email
      emailLink.setAttribute('href', `mailto:${data.email}`)
      copyBtn.dataset.email = data.email
      form.hidden = true
      result.hidden = false
      status.textContent = 'Verified — here is the address.'
      emailLink.focus()
    } catch (error) {
      // Only surface messages we threw ourselves; a network-level TypeError
      // ("Failed to fetch") is not user-friendly copy.
      status.textContent =
        error instanceof Error && !(error instanceof TypeError)
          ? error.message
          : 'Verification failed. Please try again.'
      status.classList.add('error')
      if (window.turnstile) window.turnstile.reset()
    }
  }

  const copyBtn = document.getElementById('copy-btn')
  if (copyBtn) {
    const copyLabel = copyBtn.textContent
    let copyResetTimer
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.email || '')
        copyBtn.textContent = 'Copied'
        clearTimeout(copyResetTimer)
        copyResetTimer = setTimeout(() => {
          copyBtn.textContent = copyLabel
        }, 1500)
      } catch {
        /* The mailto link still works. */
      }
    })
  }
</script>
