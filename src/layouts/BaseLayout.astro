---
interface Props {
  title: string
  description?: string
  bodyClass?: string
}

const {
  title,
  description = 'Angus Hawkings — PM Intern @ Cloudflare · CS @ Edinburgh.',
  bodyClass = '',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        height: 100%;
      }
      body {
        font-family: Helvetica, Arial, sans-serif;
        color: #1b1916;
        background-color: #efece3;
        /* layered: dot grid · warm orange pool · cool violet pool · base wash.
           the two colour pools sit behind the frosted card so the blur picks
           them up and the liquid glass reads as glass. */
        background-image:
          radial-gradient(rgba(0, 0, 0, 0.045) 1px, transparent 1px),
          radial-gradient(
            120% 120% at 14% 6%,
            rgba(246, 130, 31, 0.18),
            transparent 52%
          ),
          radial-gradient(
            120% 120% at 86% 96%,
            rgba(108, 92, 231, 0.16),
            transparent 54%
          ),
          linear-gradient(155deg, #f6f2e9 0%, #ece6da 55%, #e6dfd0 100%);
        background-size:
          26px 26px,
          100% 100%,
          100% 100%,
          100% 100%;
        background-repeat: repeat, no-repeat, no-repeat, no-repeat;
        background-attachment: fixed;
      }
    </style>
  </body>
</html>
