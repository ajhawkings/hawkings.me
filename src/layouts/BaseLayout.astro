---
import { Font } from 'astro:assets'
import SiteNav from '~/components/SiteNav.astro'
import '~/styles/global.css'

interface Props {
  title: string
  description: string
  image?: string
  noIndex?: boolean
}

const {
  title,
  description,
  image = '/og-image.png',
  noIndex = false,
} = Astro.props
const canonicalPath =
  Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/$/, '')}/`
const canonical = new URL(canonicalPath, Astro.site)
const ogImage = new URL(image, Astro.site)
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://www.hawkings.me/#person',
      name: 'Angus Hawkings',
      url: 'https://www.hawkings.me/',
      affiliation: [
        {
          '@type': 'Organization',
          name: 'Cloudflare',
          url: 'https://www.cloudflare.com/',
        },
        {
          '@type': 'CollegeOrUniversity',
          name: 'The University of Edinburgh',
          url: 'https://www.ed.ac.uk/',
        },
        {
          '@type': 'CollegeOrUniversity',
          name: 'ETH Zürich',
          url: 'https://ethz.ch/',
        },
      ],
      sameAs: [
        'https://github.com/ajhawkings',
        'https://linkedin.com/in/angus-hawkings',
        'https://x.com/angusjh',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.hawkings.me/#website',
      url: 'https://www.hawkings.me/',
      name: 'Angus Hawkings',
      inLanguage: 'en-GB',
      publisher: {
        '@id': 'https://www.hawkings.me/#person',
      },
    },
  ],
}
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      let storedTheme = null
      try {
        storedTheme = localStorage.getItem('theme')
      } catch {
        /* storage blocked — fall back to the system preference */
      }
      const systemDark = window.matchMedia(
        '(prefers-color-scheme: dark)'
      ).matches
      document.documentElement.dataset.theme =
        storedTheme === 'dark' || storedTheme === 'light'
          ? storedTheme
          : systemDark
            ? 'dark'
            : 'light'
    </script>
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-instrument" />
    <Font cssVariable="--font-geist-mono" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="theme-color"
      content="#eaf0f6"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0d1420"
      media="(prefers-color-scheme: dark)"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Angus Hawkings" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Angus Hawkings — personal website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="twitter:image:alt"
      content="Angus Hawkings — personal website"
    />
    <title>{title}</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <slot name="head" />
  </head>
  <body>
    <div class="sky" aria-hidden="true">
      <div class="blob b1"></div>
      <div class="blob b2"></div>
      <div class="blob b3"></div>
    </div>
    <SiteNav />
    <slot />
  </body>
</html>
