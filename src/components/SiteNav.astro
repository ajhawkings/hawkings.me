  <div class="nav-actions">
    <a class="nav-link cta" href="/contact">Say hello</a>
    <button
      class="icon-button theme-toggle"
      type="button"
      aria-label="Toggle dark mode"
    >
      <svg
        class="moon"
        viewBox="0 0 24 24"
        fill="none"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M12 3a6.8 6.8 0 0 0 8.7 8.7A8.5 8.5 0 1 1 12 3Z"></path>
      </svg>
      <svg
        class="sun"
        viewBox="0 0 24 24"
